{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"isolatedModules": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"incremental": true,
		"strictPropertyInitialization": false,
		"declaration": false,
		"types": ["vitest/globals", "node"]
	},
	"include": ["src"]
}
