{
	"expo": {
		"name": "Mosaic",
		"slug": "mobile",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "com.mosaic.mobile",
		"userInterfaceStyle": "automatic",
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#000000",
				"foregroundImage": "./assets/images/icon-white.png",
				"monochromeImage": "./assets/images/icon-white.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.mosaic.mobile"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#FFFFFF",
					"image": "./assets/images/splash-icon-black.png",
					"dark": {
						"image": "./assets/images/splash-icon-white.png",
						"backgroundColor": "#000000"
					},
					"imageWidth": 64
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "7395a613-8a47-4145-a36b-7e44ca1f2287"
			}
		},
		"ios": {
			"bundleIdentifier": "com.mosaic.mobile"
		}
	}
}
